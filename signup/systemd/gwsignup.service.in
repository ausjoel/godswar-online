# @NAME@.service - GodsWar account sign-up site (GodsWar-VPS/signup).
# Generated by install.sh from systemd/gwsignup.service.in; edit the template, not this file.
[Unit]
Description=GodsWar account sign-up site (@NAME@, port @PORT@, database @DB@)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@PREFIX@/app
ExecStart=/usr/bin/python3 -I @PREFIX@/app/gwsignup.py
# Settings that are not secret (rewritten by install.sh):
EnvironmentFile=/etc/@NAME@/gwsignup.env
# Secrets: root-owned 0600 files, handed to the service by systemd (never in the environment).
LoadCredential=db_password:/etc/@NAME@/db_password
LoadCredential=secret_key:/etc/@NAME@/secret_key
# Resend API key for outgoing mail. install.sh creates this file EMPTY (= mail off) if it is
# missing, because a missing file would stop the unit; ops/set-resend-key.sh fills it in.
LoadCredential=resend_api_key:/etc/@NAME@/resend_api_key
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# Network: only loopback (Caddy in front, PostgreSQL on 127.0.0.1). When a Resend key is set,
# install.sh / ops/set-resend-key.sh add /etc/systemd/system/@NAME@.service.d/mail.conf
# (IPAddressAllow=any) so the app can reach api.resend.com and DNS; install.sh removes that
# drop-in again when the key file is empty. The app itself only connects to GWSIGNUP_RESEND_URL.
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
