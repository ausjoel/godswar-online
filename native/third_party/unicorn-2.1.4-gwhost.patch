+/* gwhost patch: fast x87 paths. Exact floatx80 <-> float32/float64 conversions for normal numbers and zeros
+ * by bit manipulation, and add/sub/mul/div computed in host double when the guest's precision control is
+ * 53 or 24 bit and rounding is to-nearest (the x87 result is then the same as the double result, rounded to
+ * float for PC=24; only the extended exponent range and double rounding of PC=24 adds differ). Anything
+ * else (denormals, inf/nan, 64-bit precision, other rounding modes, exceptions to raise) falls back to the
+ * softfloat helpers. gw_x87_fast=0 disables it. */
+int gw_x87_fast = 1;
+static inline bool gw_fx_to_d(floatx80 a, double *out)
+{
+    uint32_t e = a.high & 0x7fff; uint64_t m = a.low; uint64_t sign = (uint64_t)(a.high >> 15) << 63, bits;
+    if (e == 0) { if (m) return false; bits = sign; memcpy(out, &bits, 8); return true; }
+    if (e == 0x7fff || !(m >> 63) || (m & 0x7ff)) return false;      /* special, unnormal, or needs rounding */
+    int de = (int)e - 16383 + 1023; if (de <= 0 || de >= 0x7ff) return false;
+    bits = sign | ((uint64_t)de << 52) | ((m >> 11) & 0xfffffffffffffULL); memcpy(out, &bits, 8); return true;
+}
+static inline bool gw_d_to_fx(double d, floatx80 *out)
+{
+    uint64_t bits; memcpy(&bits, &d, 8);
+    uint32_t de = (bits >> 52) & 0x7ff; uint16_t sign = (uint16_t)((bits >> 63) << 15); uint64_t m = bits & 0xfffffffffffffULL;
+    if (de == 0) { if (m) return false; out->high = sign; out->low = 0; return true; }
+    if (de == 0x7ff) return false;
+    out->high = sign | (uint16_t)(de - 1023 + 16383); out->low = (1ULL << 63) | (m << 11); return true;
+}
+static inline bool gw_fast_ok(CPUX86State *env)
+{
+    return gw_x87_fast && env->fp_status.float_rounding_mode == float_round_nearest_even &&
+           env->fp_status.floatx80_rounding_precision != 80;
+}
+/* op: 0 add, 1 sub, 2 mul, 3 div */
+static inline bool gw_fast_arith(CPUX86State *env, int op, floatx80 a, floatx80 b, floatx80 *r)
+{
+    double x, y, z;
+    if (!gw_fast_ok(env) || !gw_fx_to_d(a, &x) || !gw_fx_to_d(b, &y)) return false;
+    switch (op) { case 0: z = x + y; break; case 1: z = x - y; break; case 2: z = x * y; break; default: if (y == 0) return false; z = x / y; }
+    if (env->fp_status.floatx80_rounding_precision == 32) { float f = (float)z; if (f != f || f - f != 0 || (f != 0 && fabsf(f) < 1.17549435e-38f) || (f == 0 && z != 0)) return false; z = f; }
+    return gw_d_to_fx(z, r);
+}
+static inline bool gw_fast_f32_to_fx(uint32_t v, floatx80 *r)
+{
+    uint32_t e = (v >> 23) & 0xff, m = v & 0x7fffff; uint16_t sign = (uint16_t)((v >> 31) << 15);
+    if (e == 0) { if (m) return false; r->high = sign; r->low = 0; return true; }
+    if (e == 0xff) return false;
+    r->high = sign | (uint16_t)(e - 127 + 16383); r->low = (1ULL << 63) | ((uint64_t)m << 40); return true;
+}
+static inline bool gw_fast_f64_to_fx(uint64_t v, floatx80 *r)
+{
+    double d; memcpy(&d, &v, 8); return gw_d_to_fx(d, r);
+}
