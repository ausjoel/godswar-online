+/* gwhost patch: unicorn replaced QEMU's inline icount_decr test at TB start with a helper CALL per TB
+ * (~9% of the emulator thread in the GodsWar world). gw_tb_exit_inline=1 restores QEMU's inline
+ * load + branch to an exit label at the TB end; the helper is only used when it is 0. */
+extern int gw_tb_exit_inline;
+extern __thread TCGLabel *gw_exitreq_label;
 static inline void gen_tb_start(TCGContext *tcg_ctx, TranslationBlock *tb)
 {
+    if (gw_tb_exit_inline && tcg_ctx->delay_slot_flag == NULL) {
+        TCGv_i32 count = tcg_temp_new_i32(tcg_ctx);
+        gw_exitreq_label = gen_new_label(tcg_ctx);
+        tcg_gen_ld_i32(tcg_ctx, count, tcg_ctx->cpu_env,
+                       offsetof(ArchCPU, neg.icount_decr.u32) - offsetof(ArchCPU, env));
+        tcg_gen_brcondi_i32(tcg_ctx, TCG_COND_LT, count, 0, gw_exitreq_label);
+        tcg_temp_free_i32(tcg_ctx, count);
+        return;
+    }
+    gw_exitreq_label = NULL;
     TCGv_ptr puc = tcg_const_ptr(tcg_ctx, tcg_ctx->uc);
     TCGv_i32 tmp = tcg_const_i32(tcg_ctx, 0);
     // Unicorn:
@@ -57,6 +72,10 @@
         tcg_set_insn_param(tcg_ctx->icount_start_insn, 1, num_insns);
     }
 
+    if (gw_exitreq_label) {   /* gwhost patch */
+        gen_set_label(tcg_ctx, gw_exitreq_label);
+        gw_exitreq_label = NULL;
+    }
     tcg_gen_exit_tb(tcg_ctx, tb, TB_EXIT_REQUESTED);
 }
 
