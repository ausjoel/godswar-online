# GodsWar settings: answers for ./setup.sh. Copy to config/godswar.env (ignored by git) and run
#   sudo ./setup.sh --config config/godswar.env --yes
# Empty values are asked for (or take the default with --yes). Flags on the command line win over this file.
# Nothing secret has to go here: setup.sh makes random passwords and keys itself and keeps them in
# root-only files (/etc/godswar on Linux, local/secrets on macOS).

# vps | local | docker
GODSWAR_MODE=

# Address players' clients connect to (IPv4). Empty: VPS = detected public IP, local = 127.0.0.1.
# Use your LAN IP (e.g. 192.168.1.20) to let other computers on your network join.
GODSWAR_HOST=

# Domain for the HTTPS sign-up site on a VPS (point its DNS A record at the server first).
# Empty or "none": <ip-with-dashes>.sslip.io, which needs no DNS set-up.
GODSWAR_DOMAIN=

# Shown on the sign-up site and in its mails.
GODSWAR_SERVER_NAME=GodsWar

# Ports players connect to (open these in your provider's firewall too). Management stays on 127.0.0.1.
GODSWAR_LOGIN_PORT=6999
GODSWAR_GAME_PORT=7000
GODSWAR_MANAGEMENT_PORT=9090

# Rule set: "reborn" (default) lifts the original game's limits (gear quality 20 / grade 25 instead of 10 / 12);
# "classic" keeps the original limits. See docs/EDITIONS.md.
GODSWAR_EDITION=reborn

# First administrator (GM commands on). Lowercase letters/digits, 4-16. Password: generated if empty.
GODSWAR_ADMIN_USER=admin
GODSWAR_ADMIN_PASSWORD=

# Database. Password: generated if empty (letters, digits, - and _ only, 12 or more).
POSTGRES_DB=godswar
POSTGRES_USER=godswar
POSTGRES_PASSWORD=
# Only if PostgreSQL 17 does not listen on its usual port (setup.sh finds it on Debian/Ubuntu).
GODSWAR_PG_PORT=

# Let anyone create an account by logging in with a new name (true/false). Prefer the sign-up site.
GODSWAR_ALLOW_REGISTRATION=false

# Optional parts: yes / no. Defaults: sign-up site and firewall yes on a VPS, no on a local install; editor no.
GODSWAR_SIGNUP=
GODSWAR_EDITOR=
GODSWAR_FIREWALL=

# Sign-up mail (email confirmation, password reset) through Resend (resend.com). "none" = mail off.
# The sender must be on a domain you verified in Resend. The key is read from a file (never put it here).
GODSWAR_MAIL_FROM=none
GODSWAR_RESEND_API_KEY_FILE=

# Linux install folder.
GODSWAR_PREFIX=/opt/godswar

# --- Docker mode only (docker-compose.yml reads these; setup.sh --docker fills them in) ---
GODSWAR_DEVELOPER_COMMANDS_ENABLED=false
GODSWAR_DEVELOPER_ACCOUNT_IDS=
